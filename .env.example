# ==============================================================================
# RESCURO Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*

# Telephony: Vobiz (Exclusive Telephony Provider)
# Note: BASE_WS_URL is used by /vobiz/answer to return the WebSocket media URL to Vobiz.
# Local dev: ws://127.0.0.1:8000 or ngrok/cloudflared tunnel URL: wss://your-subdomain.ngrok-free.app
# Production (e.g., Render): wss://rescuro-api.onrender.com
BASE_WS_URL=ws://127.0.0.1:8000
VOBIZ_API_KEY=your_vobiz_api_key_here
VOBIZ_API_SECRET=your_vobiz_api_secret_here

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_secret_string_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for local development)
DATABASE_URL=sqlite+aiosqlite:///./rescuro.db

# Speech-to-Text (STT) Provider Settings (Stubbed by default; plug in when chosen)
STT_PROVIDER=stub
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# Text-to-Speech (TTS) Provider Settings (Stubbed by default; plug in when chosen)
TTS_PROVIDER=stub
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
