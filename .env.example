# ==============================================================================
# EchoSphere Backend Environment Configuration
# ==============================================================================

# Agora RTC App ID obtained from Agora Console project dashboard
AGORA_APP_ID=your_agora_app_id_here

# Agora App Certificate used to sign secure RTC dynamic tokens
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# Agora REST API Customer Key / Basic Auth ID for Conversational AI engine
AGORA_CUSTOMER_KEY=your_agora_customer_key_here

# Agora REST API Customer Secret for Conversational AI engine orchestration
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# Twilio Account SID from Twilio Console for telephony authentication
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here

# Twilio Auth Token for webhook signature validation and REST API calls
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio incoming phone number in E.164 format (e.g. +1234567890)
TWILIO_PHONE_NUMBER=+1234567890

# Deepgram API Key for Nova-2 multilingual streaming speech-to-text
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# OpenAI API Key with access to gpt-4o-mini for structured slot extraction
OPENAI_API_KEY=your_openai_api_key_here

# Supabase project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (secret server-side key, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Slack Incoming Webhook URL to send escalation alerts with Block Kit
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00/B00/XXXX

# Confidence escalation threshold (0.0 to 1.0) below which calls are escalated
CONFIDENCE_ESCALATION_THRESHOLD=0.65

# Server host and port configuration
HOST=0.0.0.0
PORT=8000
